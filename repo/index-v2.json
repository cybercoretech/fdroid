{"repo": {"name": {"en-US": "Cybercore"}, "description": {"en-US": "Apps from Cybercore Tech: privacy-first, offline-first tools with a CYBERGRID look. Every APK here is the exact signed release published on GitHub, re-verified (SHA-256 + developer signing certificate) before it is listed."}, "icon": {"en-US": {"name": "/icons/icon.png", "sha256": "6a541bf5ee25bcb63fd45ed2526526832259c97256f8507cd7bed8a9e1bde9d8", "size": 17557}}, "address": "https://cybercoretech.github.io/fdroid/repo", "timestamp": 1792533344000, "categories": {"Connectivity": {"name": {"en-US": "Connectivity"}}, "Graphics": {"name": {"en-US": "Graphics"}}, "Multimedia": {"name": {"en-US": "Multimedia"}}, "Security": {"name": {"en-US": "Security"}}}}, "packages": {"dev.cybercore.cybermeta": {"metadata": {"added": 1792533130000, "categories": ["Security", "Graphics"], "changelog": "https://github.com/cybercoretech/cybermeta-android-app/releases", "issueTracker": "https://github.com/cybercoretech/cybermeta-android-app/issues", "lastUpdated": 1792533130000, "license": "MIT", "sourceCode": "https://github.com/cybercoretech/cybermeta-android-app", "webSite": "https://cybercoretech.github.io/cybermeta-android-app/", "authorEmail": "dev@cybercoretech.net", "authorName": "Cybercore Tech", "name": {"en-US": "Cybermeta"}, "summary": {"en-US": "See what your photos give away, and share clean copies"}, "description": {"en-US": "Shows the metadata hidden in your photos (GPS, camera, dates) and makes\nclean copies to share or save, using the same Rust scrubber as the desktop\ncybermeta tool.\n\n* Clean modes: share-safe, location only, anonymous camera, pixels only, shift dates\n* Share straight from your gallery to \"Clean with Cybermeta\"\n* No internet permission"}, "icon": {"en-US": {"name": "/dev.cybercore.cybermeta/en-US/icon_tJedGXb1zWI912zsvPq-_ABe2u_7jUJM017Ym22IrQs=.png", "sha256": "b4979d1976f5cd623dd76cecbcfabefc005edaeffb8d424cd35ed89b6d88ad0b", "size": 37293}}, "preferredSigner": "88390595f5fbf171