}, "authorEmail": "dev@cybercoretech.net", "authorName": "Cybercore Tech", "name": {"en-US": "CyberVault"}, "summary": {"en-US": "Offline password vault with Keysmith built in"}, "description": {"en-US": "An offline password vault with the Keysmith generator built in. It uses\nthe same encrypted vault file format as the desktop CyberVault (Argon2id +\nChaCha20-Poly1305), from the same Rust code, so a vault opens on either.\n\n* No internet permission: your secrets only leave the phone when you export them\n* Keysmith: random passwords or EFF diceware passphrases with an entropy meter\n* Export and import the encrypted vault file to move it to and from the desktop\n* No screenshots, a self-clearing sensitive clipboard, and auto-lock\n\nThere's no recovery if you forget the master password, by design."}, "icon": {"en-US": {"name": "/dev.cybercore.cybervault/en-US/icon_MfjYJ2P0ZqqxaitmMYP7FY227HxIwH0q8G3T6DM6n_o=.png", "sha256": "31f8d82763f466aab16a2b663183fb158db6ec7c48c07d2af06dd3e8333a9ffa", "size": 18263}}, "preferredSigner": "9dfa3699b793ad16af999b2fbe99b4b13ee26f8014705cc661521ee2b15e52cb"}, "versions": {"234aaf112638b74b78f1a279cc75bff4c8d81eda267375541cd07daa2e9759e5": {"added": 1792533130000, "file": {"name": "/dev.cybercore.cybervault_1000.apk", "sha256": "234aaf112638b74b78f1a279cc75bff4c8d81eda267375541cd07daa2e9759e5", "size": 7036985}, "manifest": {"nativecode": ["arm64-v8a", "x86_64"], "versionName": "0.1.0", "versionCode": 1000, "usesSdk": {"minSdkVersion": 30, "targetSdkVersion": 36}, "signer": {"sha256": ["9dfa3699b793ad16af999b2fbe99b4b13ee26f8014705cc661521ee2b15e52cb"]}, "usesPermission": [{"name": "dev.cybercore.cybervault.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}}}}, "dev.cybercore.holodrive.photos": {"metadata": {"added": 1792533130000, "categories": ["Multimedia", "Connectivity"], "changelog": "https://github.com/cybercoretech/holodrive-android-app/releases", "issueTracker": "https://github.com/cybercoretech/holodrive-android-app/issues", "