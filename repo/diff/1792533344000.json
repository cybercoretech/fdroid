{"repo": {"timestamp": 1792542039000, "categories": {"System": {"name": {"en-US": "System"}}}}, "packages": {"dev.cybercore.nightwatch": {"metadata": {"added": 1792540058000, "categories": ["System", "Connectivity"], "changelog": "https://github.com/cybercoretech/nightwatch-android-app/releases", "issueTracker": "https://github.com/cybercoretech/nightwatch-android-app/issues", "lastUpdated": 1792540058000, "license": "MIT", "sourceCode": "https://github.com/cybercoretech/nightwatch-android-app", "webSite": "https://github.com/cybercoretech/nightwatch-android-app", "authorEmail": "dev@cybercoretech.net", "authorName": "Cybercore Tech", "name": {"en-US": "Nightwatch"}, "summary": {"en-US": "Watch and control your self-hosted services from your phone"}, "description": {"en-US": "The phone app for nightwatchd, the Cybercore operations gateway. See\nthe status of the services on your own machines and act on them, over\nyour private network or Tailscale.\n\n* Several hosts, switched from the title bar\n* Device tokens with three permission tiers; risky actions need biometric confirmation\n* Instant alerts through your own ntfy server (UnifiedPush), or a check every 15 minutes\n* No account, no analytics; screenshots are blocked\n\nRequires nightwatchd running on the machines you want to watch."}, "icon": {"en-US": {"name": "/dev.cybercore.nightwatch/en-US/icon_BPVN3mhBnr5aQko9MHS-gQOWiLPD7Z5mWM-SKyDMEN4=.png", "sha256": "04f54dde68419ebe5a424a3d3074be81039688b3c3ed9e6658cf922b20cc10de", "size": 20178}}, "preferredSigner": "be90ca53b53c48c52a5a75a5d60191a8dd6e08219ff6074c7ce36d6db961b700"}, "versions": {"9b7fa70eb3084b50b9e6d7d74ac957969be97ee392eb0e4f010b00c19c436b0b": {"added": 1792540058000, "file": {"name": "/dev.cybercore.nightwatch_1000.apk", "sha256": "9b7fa70eb3084b50b9e6d7d74ac957969be97ee392eb0e4f010b00c19c436b0b", "size": 5803840}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "0.1.0", "versionCode": 1000, "usesSdk": {"minSdkVersion": 30, "targetSdkVersion": 36}, "signer": {"sha256": ["be90ca53b53c48c52a5a75a5d60191a8dd6e08219ff6074c7ce36d6db961b700"]}, "usesPermission": [{"name": "android.permission.INTERNET"}, {"name": "android.permission.USE_BIOMETRIC"}, {"name": "android.permission.POST_NOTIFICATIONS"}, {"name": "android.permission.FOREGROUND_SERVICE"}, {"name": "android.permission.FOREGROUND_SERVICE_DATA_SYNC"}, {"name": "android.permission.WAKE_LOCK"}, {"name": "android.permission.ACCESS_NETWORK_STATE"}, {"name": "android.permission.RECEIVE_BOOT_COMPLETED"}, {"name": "dev.cybercore.nightwatch.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"}]}, "antiFeatures": {"NonFreeNet": {"en-US": "Needs nightwatchd, which you host yourself."}}}}}, "dev.cybercore.signalwarden": {"metadata": {"added": 1792542029000, "categories": ["Connectivity", "System"], "changelog": "https://github.com/cybercoretech/signalwarden/blob/main/CHANGELOG.md", "issueTracker": "https://github.com/cybercoretech/signalwarden/issues", "lastUpdated": 1792542029000, "license": "Apache-2.0", "sourceCode": "https://github.com/cybercoretech/signalwarden", "webSite": "https://cybercoretech.github.io/signalwarden/", "authorEmail": "dev@cybercoretech.net", "authorName": "Cybercore Tech", "name": {"en-US": "SignalWarden"}, "summary": {"en-US": "See what your connection is doing, and keep the diagnostics on your phone"}, "description": {"en-US": "Network diagnostics with clear privacy boundaries. SignalWarden shows what\nAndroid knows about your active connection, and on demand measures how long\nDNS, the TCP connect and a certificate-verified TLS handshake take.\n\n* Transport, validated-internet and metered state, and whether a VPN is active\n* Interface, addresses, DNS servers, proxy and routes\n* On-tap latency breakdown: resolver, TCP and TLS, each timed separately\n* No account, analytics, stored history or SignalWarden server\n\nIt isn't a VPN or packet analyzer, and nothing runs in the background."}, "icon": {"en-US": {"