{"repo": {"timestamp": 1792542039000}, "packages": {"dev.cybercore.signalwarden": {"metadata": {"added": 1792542029000, "categories": ["Connectivity", "System"], "changelog": "https://github.com/cybercoretech/signalwarden/blob/main/CHANGELOG.md", "issueTracker": "https://github.com/cybercoretech/signalwarden/issues", "lastUpdated": 1792542029000, "license": "Apache-2.0", "sourceCode": "https://github.com/cybercoretech/signalwarden", "webSite": "https://cybercoretech.github.io/signalwarden/", "authorEmail": "dev@cybercoretech.net", "authorName": "Cybercore Tech", "name": {"en-US": "SignalWarden"}, "summary": {"en-US": "See what your connection is doing, and keep the diagnostics on your phone"}, "description": {"en-US": "Network diagnostics with clear privacy boundaries. SignalWarden shows what\nAndroid knows about your active connection, and on demand measures how long\nDNS, the TCP connect and a certificate-verified TLS handshake take.\n\n* Transport, validated-internet and metered state, and whether a VPN is active\n* Interface, addresses, DNS servers, proxy and routes\n* On-tap latency breakdown: resolver, TCP and TLS, each timed separately\n* No account, analytics, stored history or SignalWarden server\n\nIt isn't a VPN or packet analyzer, and nothing runs in the background."}, "icon": {"en-US": {"name": "/dev.cybercore.signalwarden/en-US/icon_oLn0L5afxTvM6kLs0r3neHQkf4ThB9SXuWalu1YifX4=.png", "sha256": "a0b9f42f969fc53bccea42ecd2bde77874247f84e107d497b966a5bb56227d7e", "size": 17047}}, "preferredSigner": "c8a7418085ee06271f46768ce2356e80834d1d85309f3d58cd8113f4f29679c6"}, "versions": {"9c691163f8dc60f91fd28eef66fe3a04c6ffdd1567ef979ddaf7a1099c43458b": {"added": 1792542029000, "file": {"name": "/dev.cybercore.signalwarden_1000.apk", "sha256": "9c691163f8dc60f91fd28eef66fe3a04c6ffdd1567ef979ddaf7a1099c43458b", "size": 1539268}, "manifest": {"nativecode": ["arm64-v8a", "armeabi-v7a", "x86", "x86_64"], "versionName": "0.1.0", "versionCode": 1000, "usesSdk": {"minSdk