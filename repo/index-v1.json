{"repo": {"timestamp": 1792540333000, "version": 20002, "name": "Cybercore", "icon": "icon.png", "address": "https://cybercoretech.github.io/fdroid/repo", "description": "Apps from Cybercore Tech: privacy-first, offline-first tools with a CYBERGRID look. Every APK here is the exact signed release published on GitHub, re-verified (SHA-256 + developer signing certificate) before it is listed."}, "requests": {"install": [], "uninstall": []}, "apps": [{"authorEmail": "dev@cybercoretech.net", "authorName": "Cybercore Tech", "categories": ["Security", "Graphics"], "changelog": "https://github.com/cybercoretech/cybermeta-android-app/releases", "suggestedVersionCode": "100", "description": "Shows the metadata hidden in your photos (GPS, camera, dates) and makes\nclean copies to share or save, using the same Rust scrubber as the desktop\ncybermeta tool.\n\n* Clean modes: share-safe, location only, anonymous camera, pixels only, shift dates\n* Share straight from your gallery to \"Clean with Cybermeta\"\n* No internet permission", "issueTracker": "https://github.com/cybercoretech/cybermeta-android-app/issues", "license": "MIT", "name": "Cybermeta", "sourceCode": "https://github.com/cybercoretech/cybermeta-android-app", "summary": "See what your photos give away, and share clean copies", "webSite": "https://cybercoretech.github.io/cybermeta-android-app/", "added": 1792533130000, "packageName": "dev.cybercore.cybermeta", "lastUpdated": 1792533130000, "localized": {"en-US": {"icon": "icon_tJedGXb1zWI912zsvPq-_ABe2u_7jUJM017Ym22IrQs=.png"}}}, {"authorEmail": "dev@cybercoretech.net", "authorName": "Cybercore Tech", "categories": ["Security"], "changelog": "https://github.com/cybercoretech/cybervault-android-app/releases", "suggestedVersionCode": "1000", "description": "An offline password vault with the Keysmith generator built in. It uses\nthe same encrypted vault file format as the desktop CyberVault (Argon2id +\nChaCha20-Poly1305), from the same Rust code, so a vault opens on either.\n\n* No internet permission: your secrets only leave the phone when you export them\n* Keysmith: random passwords or EFF diceware passphrases with an entropy meter\n* Export and import the encrypted vault file to move it to and from the desktop\n* No screenshots, a self-clearing sensitive clipboard, and auto-lock\n\nThere's no recovery if you forget the master password, by design.", "issueTracker": "https://github.com/cybercoretech/cybervault-android-app/issues", "license": "MIT", "name": "CyberVault", "sourceCode": "https://github.com/cybercoretech/cybervault-android-app", "summary": "Offline password vault with Keysmith built in", "webSite": "https://cybercoretech.github.io/cybervault-android-app/", "added": 1792533130000, "packageName": "dev.cybercore.cybervault", "lastUpdated": 1792533130000, "localized": {"en-US": {"icon": "icon_MfjYJ2P0ZqqxaitmMYP7FY227HxIwH0q8G3T6DM6n_o=.png", "phoneScreenshots": ["1.png", "2.png", "3.png", "4.png", "5.png"], "whatsNew": "First release: an offline vault with the desktop CyberVault format, the Keysmith password and passphrase generator, export/import, auto-lock, and a self-clearing sensitive clipboard.\n"}}}, {"antiFeatures": ["NonFreeNet"], "authorEmail": "dev@cybercoretech.net", "authorName": "Cybercore Tech", "categories": ["Multimedia", "Connectivity"], "changelog": "https://github.com/cybercoretech/holodrive-android-app/releases", "suggestedVersionCode": "2001", "description": "The phone companion for Holodrive, the self-hosted Cybercore web file\nmanager. Browse your photos, upload or share files into Holodrive, sync\nfolders, and create password-protected share links whose passphrases are\ngenerated on the phone with Keysmith (and can be saved to CyberVault).\n\nRequires a Holodrive server you run yourself, reached over your own network\nor Tailscale.", "issueTracker": "https://github.com/cybercoretech/holodrive-android-app/issues", "license": "Apache-2.0", "name": "Holodrive Photos", "sourceCode": "https://github.com/cybercoretech/holodrive-android-app", "summary": "Photo gallery and uploader for your self-hosted Holodrive", "webSite": "https://github.com/cybercoretech/holodrive-android-app", "added": 1792533130000, "packageName": "dev.cybercore.holodrive.photos", "lastUpdated": 1792533130000, "localized": {"en-US": {"icon": "icon_7hrbsYUkXM_Vv28N4dCaV-sS7ahv7sVpCTMJcNWP8Iw=.png", "phoneScreenshots": ["1.png", "2.png", "3.png", "4.png", "5.png"]}}}, {"antiFeatures": ["NonFreeNet"], "authorEmail": "dev@cybercoretech.net", "authorName": "Cybercore Tech", "categories": ["System", "Connectivity"], "changelog": "https://github.com/cybercoretech/nightwatch-android-app/releases", "suggestedVersionCode": "1000", "description": "The phone app for nightwatchd, the Cybercore operations gateway. See\nthe status of the services on your own machines and act on them, over\nyour private network or Tailscale.\n\n* Several hosts, switched from the title bar\n* Device tokens with three permission tiers; risky actions need biometric confirmation\n* Instant alerts through your own ntfy server (UnifiedPush), or a check every 15 minutes\n* No account, no analytics; screenshots are blocked\n\nRequires nightwatchd running on the machines you want to watch.", "issueTracker": "https://github.com/cybercoretech/nightwatch-android-app/issues", "license": "MIT", "name": "Nightwatch", "sourceCode": "https://github.com/cybercoretech/nightwatch-android-app", "summary": "Watch and control your self-hosted services from your phone", "webSite": "https://github.com/cybercoretech/nightwatch-android-app", "added": 1792540058000, "packageName": "dev.cybercore.nightwatch", "lastUpdated": 1792540058000, "localized": {"en-US": {"icon": "icon_BPVN3mhBnr5aQko9MHS-gQOWiLPD7Z5mWM-SKyDMEN4=.png"}}}], "packages": {"dev.cybercore.cybermeta": [{"added": 1792533130000, "apkName": "dev.cybercore.cybermeta_100.apk", "hash": "a25fd0798c0b4ba3f505ccaf382f1d108b58b28f5f3683634ad05e027388c197", "hashType": "sha256", "minSdkVersion